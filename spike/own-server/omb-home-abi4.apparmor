# omb-home-abi4: omb-home-narrow written for AppArmor ABI 4.0, where creating a user namespace is mediated and must be
# allowed by name (userns). ABI 4.0 also mediates unix sockets, io_uring and message queues, which ABI 3.0 (Docker's
# default) leaves alone, so they are allowed here to match what docker-default permits.
abi <abi/4.0>,
include <tunables/global>

profile omb-home-abi4 flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network,
  unix,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,
  io_uring,
  mqueue,
  # The bot box: its own user namespace, tmpfs, proc, devpts and bind mounts inside it, then pivot_root into them.
  userns,
  mount,
  pivot_root,
  deny mount fstype=overlay,
  deny mount fstype=fuse,
  deny mount fstype=fuseblk,
  deny mount fstype=sysfs,
  deny mount fstype=mqueue,
  deny mount fstype=cgroup,
  deny mount fstype=cgroup2,
  deny mount fstype=ramfs,
  deny mount fstype=binfmt_misc,
  deny mount fstype=bpf,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=omb-home-abi4,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # systempaths=unconfined lifts Docker's masks over /proc and /sys; these put back what the masks hid.
  deny @{PROC}/acpi/** rwklx,
  deny @{PROC}/asound/** rwklx,
  deny @{PROC}/interrupts rwklx,
  deny @{PROC}/keys rwklx,
  deny @{PROC}/latency_stats rwklx,
  deny @{PROC}/sched_debug rwklx,
  deny @{PROC}/scsi/** rwklx,
  deny @{PROC}/timer_list rwklx,
  deny @{PROC}/timer_stats rwklx,
  deny @{PROC}/sys/** w,
  deny /sys/devices/system/cpu/cpu*/thermal_throttle/** rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,tracedby,read,readby) peer=omb-home-abi4,
}
