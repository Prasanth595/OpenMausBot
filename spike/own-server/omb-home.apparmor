# omb-home: AppArmor profile for the MausBot home container on a plain Docker host (own-server spike).
# Docker's own docker-default (github.com/moby/profiles/apparmor, moby docker-v29.9.2) with one change: mounts and
# pivot_root are allowed, so the bot box (bubblewrap) can build each turn's view of the files. The kernel still lets
# a mount act only inside a user and mount namespace the process made itself: the container has no CAP_SYS_ADMIN.
# The broad variant; omb-home-narrow also refuses the filesystem types bubblewrap never mounts.
abi <abi/3.0>,
include <tunables/global>

profile omb-home flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,
  # The bot box: tmpfs, proc, devpts and bind mounts in its own namespaces, then pivot_root into them.
  mount,
  pivot_root,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=omb-home,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # systempaths=unconfined lifts Docker's masks over /proc and /sys (bubblewrap must mount a fresh /proc, and the
  # kernel refuses that while masked paths cover the container's). These put back what the masks hid.
  deny @{PROC}/acpi/{,**} rwklx,
  deny @{PROC}/asound/{,**} rwklx,
  deny @{PROC}/interrupts rwklx,
  deny @{PROC}/keys rwklx,
  deny @{PROC}/latency_stats rwklx,
  deny @{PROC}/sched_debug rwklx,
  deny @{PROC}/scsi/{,**} rwklx,
  deny @{PROC}/timer_list rwklx,
  deny @{PROC}/timer_stats rwklx,
  deny @{PROC}/sys/** w,
  deny /sys/devices/system/cpu/cpu*/thermal_throttle/** rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/{,**} rwklx,
  deny /sys/devices/virtual/powercap/{,**} rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,tracedby,read,readby) peer=omb-home,
}
