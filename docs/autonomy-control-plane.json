{
  "schema": "openmaus.autonomy-control-plane.v1",
  "mode": "bounded-autonomy",
  "default_approval": "ask",
  "session_persistence": {
    "provider": "managed-browser-profile",
    "state_at_rest": "encrypted",
    "restart_recovery": true,
    "human_sign_in_handoff": true,
    "credentials_model_visible": false,
    "profile_scope": "client-project-bot"
  },
  "lanes": {
    "observe": {
      "approval": "auto",
      "actions": ["navigate", "read", "search", "inspect", "screenshot", "download_non_executable"],
      "external_effects": false
    },
    "reversible": {
      "approval": "auto",
      "actions": ["draft", "local_edit", "local_test", "create_checkpoint", "create_evidence"],
      "external_effects": false
    },
    "consequential": {
      "approval": "ask",
      "actions": ["send", "publish", "deploy", "merge", "payment", "dns", "delete", "permission_change", "credential_change"],
      "external_effects": true
    }
  },
  "invariants": [
    "never_cross_client_profile",
    "never_expose_credentials_to_model_or_logs",
    "never_resume_past_owner_gate",
    "never_claim_done_without_verification",
    "never_duplicate_completed_checkpoint",
    "fail_closed_on_unknown_action"
  ],
  "recovery": {
    "checkpoint_required_before_step": true,
    "idempotency_key_required": true,
    "on_restart": "resume_last_verified_checkpoint",
    "on_stale_session": "pause_and_request_human_sign_in",
    "on_policy_error": "downgrade_to_ask"
  }
}
